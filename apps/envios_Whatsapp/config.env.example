# ======================================================================
# PLANTILLA DE CONFIGURACIÓN - DESPACHO WHATSAPP
# Copia este archivo como 'config.env' y define tus valores reales
# ======================================================================

# Dirección de la Evolution API (ej: http://localhost:8080 o IP de tu servidor)
EVOLUTION_URL=http://localhost:8080

# Nombre de la instancia de WhatsApp en Evolution API
EVOLUTION_INSTANCE=mi_instancia

# API Key configurada al instalar Evolution API
EVOLUTION_APIKEY=tu_api_key_aqui

# Nombre del archivo Excel con el catálogo de contactos
EXCEL_FILE=Directorio_Destinatarios.xlsx

# Nombre del archivo de bitácora y auditoría
LOG_FILE=log_envio_whatsapp.txt

# Pausa defensiva entre envíos individuales en segundos
SEND_DELAY=1.5
