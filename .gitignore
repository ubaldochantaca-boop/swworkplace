# =================================================================
# MONOREPO SWWORKPLACE - CONFIGURACIÓN PROFESIONAL GENERAL
# =================================================================

# ---------- IDENTIDAD DEL SERVIDOR (No rastrear backups de emergencia) ----------
.git_corrupto/
06_Archive/

# ---------- ENTORNOS DE EJECUCIÓN (Delegar a 05_Runtime) ----------
.venv/
venv/
**/venv/
**/env/
node_modules/
**/node_modules/
.ipynb_checkpoints/
.pnpm-store/
.eslintcache
.stylelintcache

# ---------- ARTEFACTOS DE IA Y HARDWARE (Protección RTX 5070) ----------
# No subir pesos de modelos ni datasets que deben ir en 03_Data_Lake o 04_Models
*.pth
*.onnx
*.bin
*.model
*.weights
*.pt
*.engine
*.gguf
**/datasets/
**/outputs/
**/model-es/
**/models/

# ---------- BACKEND (Java / Spring Boot / Maven) ----------
target/
**/target/
**/temp-jar/
*.jar
*.war
*.ear
# CORRECCIÓN: No ignorar la carpeta completa .mvn/ para permitir el uso de Maven Wrapper (.mvnw)
# Solo ignoramos los archivos de extensión temporal internos de Maven, manteniendo el wrapper intacto.
.mvn/wrapper/maven-wrapper.jar
.factorypath
*.class
logs/
*.log

# Archivos específicos de entornos de desarrollo Java e IDEs (ADICIÓN DE SEGURIDAD)
.classpath
.project
.settings/
.sts4-cache/
.idea/
*.iml
*.iws
.vscode/
*.code-workspace
.nbworkspace/
.nb-gradle/

# --- MODIFICACIÓN DE SEGURIDAD: COBERTURA TOTAL SQLITE Y METADATOS ---
*.db
*.db-wal
*.db-shm
*.mv.db

# ---------- ADICIÓN: CONTENEDORES Y DOCKER ----------
.docker/
*docker-compose.override.yml
*.devcontainer/

# ---------- COMPLEMENTO: Flutter / Dart (Futuro Frontend Móvil) ----------
**/android/.gradle/
**/android/local.properties
**/android/app/protobuf
**/ios/Pods/
**/.dart_tool/
**/.packages
**/.pub-cache/

# ---------- COMPLEMENTO: Multimedia de Audio (Mantenimiento Voice) ----------
# Archivos de voz temporales generados en las pruebas de ingesta en el servidor
*.wav
*.mp3
*.m4a
*.pcm

# ---------- COMPLEMENTO: Seguridad y Datos Locales (Fase SAP / SAT) ----------
# Credenciales y secretos locales que no deben subir a GitHub
.env
*.env.local
.postman/
*.globals.yaml

# --- NUEVO: PROTECCIÓN PERIMETRAL CONTABLE (EVITAR FUGAS DE DATOS PII) ---
**/uploads/
**/uploads/*
*.pdf
*.PDF
*.csv
*.xlsx
*.xls

# ---------- COMPLEMENTO: Archivos del Sistema y Temporales ----------
build/
dist/
**/build/
**/dist/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.spec
*.exe
*.dll
Thumbs.db
.DS_Store
*.bak
*.tmp
~$*.docx
~$*.xlsx
apps/AnalizadorContable/uploads/
